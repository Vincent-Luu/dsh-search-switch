{
  "name": "dsh-search-switch",
  "version": "0.1.0",
  "description": "Switch web_search between DSH native DeepSeek search and Tavily from the session composer bar, with a Tavily search-depth switch (basic/advanced).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "web-search",
    "tavily"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vincent-Luu/dsh-search-switch.git"
  },
  "bugs": {
    "url": "https://github.com/Vincent-Luu/dsh-search-switch/issues"
  },
  "homepage": "https://github.com/Vincent-Luu/dsh-search-switch#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/dispatch.js && node --check lib/tavily-provider.js && node --check lib/tavily-mapping.js && node --check lib/client.js",
    "test": "node --test --test-isolation=none test/tavily-mapping.test.mjs test/tavily-provider.test.mjs test/dispatch.test.mjs test/client-bundle.test.mjs"
  }
}
